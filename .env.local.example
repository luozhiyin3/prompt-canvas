# 环境变量配置示例
# 复制此文件为 .env.local 并填入你的 API Keys

# ==================== LLM 服务配置 ====================
# 选择 LLM 提供商: 'gemini' 或 'deepseek'
NEXT_PUBLIC_LLM_PROVIDER=gemini

# Google Gemini API Key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Key (备选, https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== 生图服务配置 ====================
# 选择生图提供商: 'fal' 或 'siliconflow'
IMAGE_PROVIDER=fal

# Fal.ai API Key (https://fal.ai/dashboard/keys)
FAL_API_KEY=your_fal_api_key_here

# SiliconFlow API Key (备选, https://cloud.siliconflow.cn/)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ==================== 静态资源 ====================
# 预置图片 CDN 地址 (可选, 默认使用本地 /presets/ 目录)
NEXT_PUBLIC_PRESET_CDN_URL=
